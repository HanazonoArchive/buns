# Copy to .env and fill in. .env is git-ignored.

# DeepSeek API key from https://platform.deepseek.com/api_keys
# Leave empty to run with the built-in rules engine instead of the model.
DEEPSEEK_API_KEY=

# deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# Shared secret between buns and the ZAP daemon. Any random string.
ZAP_API_KEY=change-me-to-something-random

# --- Notifications (optional) -------------------------------------------
# Links in alerts point here. Change it if people open buns from another address.
BUNS_PUBLIC_URL=http://localhost:8000

# Email alerts go through an SMTP server. For Gmail, create an App Password
# (Google Account > Security > App passwords) and use it as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: the system owner set on the seeded Juice Shop target.
BUNS_SEED_OWNER_NAME=
BUNS_SEED_OWNER_EMAIL=
